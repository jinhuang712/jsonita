  "sections": [
    {
      "id": "overview",
      "title": {
        "zh-CN": "概览",
        "en": "Overview"
      },
      "blocks": [
        {
          "type": "summary",
          "items": [
            {
              "label": {
                "zh-CN": "语言",
                "en": "Language"
              },
              "body": {
                "zh-CN": "应用和 CAST 文档都支持 zh-CN / en。",
                "en": "Both app and CAST docs support zh-CN / en."
              }
            },
            {
              "label": {
                "zh-CN": "键盘",
                "en": "Keyboard"
              },
              "body": {
                "zh-CN": "核心流程必须键盘可达。",
                "en": "Core flows must be keyboard reachable."
              }
            },
            {
              "label": {
                "zh-CN": "文案",
                "en": "Copy"
              },
              "body": {
                "zh-CN": "技术标识如 JSON、AI Fix、DeepSeek、secrets.json 不强行翻译。",
                "en": "Technical identifiers such as JSON, AI Fix, DeepSeek, and secrets.json are not forced into translation."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "summary",
      "title": {
        "zh-CN": "摘要",
        "en": "Summary"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "zh-CN": "本规格页记录当前实现应遵守的技术契约。若实现发生变化，需要同步更新本页和相关 plan/TODO/CHANGELIST。",
            "en": "This spec records the technical contract the current implementation should follow. If implementation changes, update this page and related plan/TODO/CHANGELIST."
          }
        }
      ]
    },
    {
      "id": "language-contract",
      "title": {
        "zh-CN": "Language Contract",
        "en": "Language Contract"
      },
      "blocks": [
        {
          "type": "table",
          "tableType": "data",
          "headers": [
            {
              "zh-CN": "对象",
              "en": "Object"
            },
            {
              "zh-CN": "约定",
              "en": "Contract"
            }
          ],
          "rows": [
            [
              {
                "zh-CN": "App UI",
                "en": "App UI"
              },
              {
                "zh-CN": "i18next + react-i18next，语言可设置。",
                "en": "i18next plus react-i18next, configurable language."
              }
            ],
            [
              {
                "zh-CN": "CAST Docs",
                "en": "CAST Docs"
              },
              {
                "zh-CN": "metadata.locales = zh-CN/en，渲染器生成语言切换。",
                "en": "metadata.locales = zh-CN/en, renderer generates language switcher."
              }
            ],
            [
              {
                "zh-CN": "Terminology",
                "en": "Terminology"
              },
              {
                "zh-CN": "路径、快捷键、代码标识保持原文。",
                "en": "Paths, shortcuts, and code identifiers keep their source form."
              }
            ]
          ]
        }
      ]
    },
    {
      "id": "invariants",
      "title": {
        "zh-CN": "不变量",
        "en": "Invariants"
      },
      "blocks": [
        {
          "type": "list",
          "items": [
            {
              "zh-CN": "按钮和表单控件要有可理解 label。",
              "en": "Buttons and form controls need understandable labels."
            },
            {
              "zh-CN": "文字不得依赖颜色单独表达状态。",
              "en": "Text must not rely on color alone to express state."
            },
            {
              "zh-CN": "文档不能出现中文-only plan/spec 发布页。",
              "en": "Docs must not publish Chinese-only plan/spec pages."
            }
          ]
        }
      ]
    },
    {
      "id": "testing-plan",
      "title": {
        "zh-CN": "测试计划",
        "en": "Testing Plan"
      },
      "blocks": [
        {
          "type": "acceptance-criteria",
          "items": [
            {
              "zh-CN": "切换 app 语言 smoke。",
              "en": "Smoke switching app language."
            },
            {
              "zh-CN": "docs:check 检查 plan/spec 双语结构。",
              "en": "docs:check checks bilingual structure for plan/spec."
            }
          ]
        }
      ]
    },
    {
      "id": "open-questions",
      "title": {
        "zh-CN": "开放问题",
        "en": "Open Questions"
      },
      "blocks": [
        {
          "type": "open-questions",
          "questions": [
            {
              "zh-CN": "未明确的行为必须先进入 TODO，而不是在实现里静默猜测。",
              "en": "Unclear behavior must enter TODO first instead of being silently guessed in implementation."
            }
          ]
        }
      ]
    }
  ]
