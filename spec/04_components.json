  "sections": [
    {
      "id": "overview",
      "title": {
        "zh-CN": "概览",
        "en": "Overview"
      },
      "blocks": [
        {
          "type": "summary",
          "items": [
            {
              "label": {
                "zh-CN": "原则",
                "en": "Principle"
              },
              "body": {
                "zh-CN": "组件以工作流密度优先，不做营销式展示页。",
                "en": "Components prioritize workflow density, not marketing-style presentation."
              }
            },
            {
              "label": {
                "zh-CN": "基础",
                "en": "Base"
              },
              "body": {
                "zh-CN": "Button、Tab、Editor、Tree、StatusBar、Modal、DiffView、History item。",
                "en": "Button, Tab, Editor, Tree, StatusBar, Modal, DiffView, History item."
              }
            },
            {
              "label": {
                "zh-CN": "边界",
                "en": "Boundary"
              },
              "body": {
                "zh-CN": "通用组件承载状态和输入，领域逻辑保留在 hooks/store/Rust command。",
                "en": "Reusable components carry state and input; domain logic stays in hooks/store/Rust commands."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "summary",
      "title": {
        "zh-CN": "摘要",
        "en": "Summary"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "zh-CN": "本规格页记录当前实现应遵守的技术契约。若实现发生变化，需要同步更新本页和相关 plan/TODO/CHANGELIST。",
            "en": "This spec records the technical contract the current implementation should follow. If implementation changes, update this page and related plan/TODO/CHANGELIST."
          }
        }
      ]
    },
    {
      "id": "component-inventory",
      "title": {
        "zh-CN": "Component Inventory",
        "en": "Component Inventory"
      },
      "blocks": [
        {
          "type": "table",
          "tableType": "data",
          "headers": [
            {
              "zh-CN": "组件",
              "en": "Component"
            },
            {
              "zh-CN": "职责",
              "en": "Responsibility"
            }
          ],
          "rows": [
            [
              {
                "zh-CN": "FloatingWindow",
                "en": "FloatingWindow"
              },
              {
                "zh-CN": "布局、tab、pane mode、statusbar 容器。",
                "en": "Layout, tabs, pane mode, and statusbar container."
              }
            ],
            [
              {
                "zh-CN": "Editor",
                "en": "Editor"
              },
              {
                "zh-CN": "CodeMirror 生命周期、lint、value sync。",
                "en": "CodeMirror lifecycle, lint, and value sync."
              }
            ],
            [
              {
                "zh-CN": "TreeView",
                "en": "TreeView"
              },
              {
                "zh-CN": "JSON node 展开、复制、类型染色。",
                "en": "JSON node expansion, copy, and type coloring."
              }
            ],
            [
              {
                "zh-CN": "SettingsModal",
                "en": "SettingsModal"
              },
              {
                "zh-CN": "设置分组、验证、保存。",
                "en": "Settings groups, validation, and save."
              }
            ],
            [
              {
                "zh-CN": "HistoryModal",
                "en": "HistoryModal"
              },
              {
                "zh-CN": "搜索、pin/star、restore。",
                "en": "Search, pin/star, and restore."
              }
            ],
            [
              {
                "zh-CN": "DiffView",
                "en": "DiffView"
              },
              {
                "zh-CN": "AI Fix before/after 和 Accept。",
                "en": "AI Fix before/after and Accept."
              }
            ]
          ]
        }
      ]
    },
    {
      "id": "invariants",
      "title": {
        "zh-CN": "不变量",
        "en": "Invariants"
      },
      "blocks": [
        {
          "type": "list",
          "items": [
            {
              "zh-CN": "Modal 可作为卡片；页面 section 不用卡片包装。",
              "en": "Modals may be cards; page sections are not wrapped as cards."
            },
            {
              "zh-CN": "按钮用图标或清晰命令文字，避免装饰性文案。",
              "en": "Buttons use icons or clear command text, avoiding decorative copy."
            },
            {
              "zh-CN": "错误状态是数据状态，不是组件重建触发器。",
              "en": "Error state is data state, not a component-rebuild trigger."
            }
          ]
        }
      ]
    },
    {
      "id": "testing-plan",
      "title": {
        "zh-CN": "测试计划",
        "en": "Testing Plan"
      },
      "blocks": [
        {
          "type": "acceptance-criteria",
          "items": [
            {
              "zh-CN": "组件交互用用户流程 smoke；纯工具函数用单测。",
              "en": "Component interactions use user-flow smoke; pure utilities use unit tests."
            }
          ]
        }
      ]
    },
    {
      "id": "open-questions",
      "title": {
        "zh-CN": "开放问题",
        "en": "Open Questions"
      },
      "blocks": [
        {
          "type": "open-questions",
          "questions": [
            {
              "zh-CN": "未明确的行为必须先进入 TODO，而不是在实现里静默猜测。",
              "en": "Unclear behavior must enter TODO first instead of being silently guessed in implementation."
            }
          ]
        }
      ]
    }
  ]
