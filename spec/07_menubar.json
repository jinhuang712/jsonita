              {
                "zh-CN": "前端捕获，不注册系统全局。",
                "en": "Captured by frontend, not registered globally."
              }
            ],
            [
              {
                "zh-CN": "Native close",
                "en": "Native close"
              },
              {
                "zh-CN": "Esc / Cmd+W",
                "en": "Esc / Cmd+W"
              },
              {
                "zh-CN": "隐藏浮窗。",
                "en": "Hide floating window."
              }
            ]
          ]
        }
      ]
    },
    {
      "id": "invariants",
      "title": {
        "zh-CN": "不变量",
        "en": "Invariants"
      },
      "blocks": [
        {
          "type": "list",
          "items": [
            {
              "zh-CN": "快捷键冲突必须给用户二次确认。",
              "en": "Shortcut conflicts must require user confirmation."
            },
            {
              "zh-CN": "无权限时不能静默失败。",
              "en": "Missing permission must not fail silently."
            },
            {
              "zh-CN": "Windows 正式快捷键体验是后续分发验收项。",
              "en": "Formal Windows shortcut experience is a later distribution acceptance item."
            }
          ]
        }
      ]
    },
