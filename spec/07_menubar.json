          "rows": [
            [
              {
                "zh-CN": "Global",
                "en": "Global"
              },
              {
                "zh-CN": "Cmd+Shift+J / Cmd+Shift+L",
                "en": "Cmd+Shift+J / Cmd+Shift+L"
              },
              {
                "zh-CN": "Rust 注册，冲突检测。",
                "en": "Registered by Rust with conflict detection."
              }
            ],
            [
              {
                "zh-CN": "Window",
                "en": "Window"
              },
              {
                "zh-CN": "Cmd+K / Cmd+\\",
                "en": "Cmd+K / Cmd+\\"
