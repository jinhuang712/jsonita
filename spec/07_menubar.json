              "body": {
                "zh-CN": "菜单栏图标提供 show、settings、quit 等动作。",
                "en": "Menu-bar icon provides show, settings, quit, and related actions."
              }
            },
            {
              "label": {
                "zh-CN": "全局快捷键",
