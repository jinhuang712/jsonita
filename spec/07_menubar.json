              },
              "body": {
                "zh-CN": "Cmd+Shift+J 和 Cmd+Shift+L 可配置。",
                "en": "Cmd+Shift+J and Cmd+Shift+L are configurable."
              }
            },
            {
              "label": {
                "zh-CN": "权限",
                "en": "Permission"
              },
              "body": {
                "zh-CN": "macOS Accessibility 权限由 modal 引导。",
                "en": "macOS Accessibility permission is guided by a modal."
              }
            }
          ]
        }
      ]
    },
