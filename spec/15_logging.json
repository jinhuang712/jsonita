            },
            {
              "label": {
                "zh-CN": "隐私",
                "en": "Privacy"
              },
              "body": {
                "zh-CN": "不记录用户 JSON 正文或 API key。",
                "en": "Do not record user JSON body or API keys."
              }
            },
            {
              "label": {
                "zh-CN": "保留",
                "en": "Retention"
              },
              "body": {
                "zh-CN": "rolling logs 保存在用户日志目录。",
                "en": "Rolling logs are stored in the user log directory."
              }
            }
          ]
        }
      ]
    },
