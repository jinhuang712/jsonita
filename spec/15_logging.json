    {
      "id": "invariants",
      "title": {
        "zh-CN": "不变量",
        "en": "Invariants"
      },
      "blocks": [
        {
          "type": "list",
          "items": [
            {
              "zh-CN": "任何日志字段不得包含完整 JSON 文档。",
              "en": "No log field may contain the full JSON document."
            },
            {
              "zh-CN": "API key、Authorization header、secrets path value 必须脱敏。",
              "en": "API key, Authorization header, and secret path values must be redacted."
            },
            {
              "zh-CN": "导出日志前用户应能理解导出范围。",
              "en": "Before exporting logs, users should understand the export scope."
            }
          ]
        }
      ]
    },
