      "blocks": [
        {
          "type": "summary",
          "items": [
            {
              "label": {
                "zh-CN": "目的",
                "en": "Purpose"
              },
              "body": {
                "zh-CN": "日志帮助定位窗口、快捷键、AI、存储、发布问题。",
                "en": "Logs help diagnose window, shortcut, AI, storage, and release issues."
