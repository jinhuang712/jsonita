            {
              "label": {
                "zh-CN": "操作",
                "en": "Actions"
              },
              "body": {
                "zh-CN": "工具按钮优先 icon，复制/设置/历史等不使用 emoji。",
                "en": "Tool buttons prefer icons; copy/settings/history do not use emoji."
              }
            }
