        }
      ]
    },
    {
      "id": "invariants",
      "title": {
        "zh-CN": "不变量",
        "en": "Invariants"
      },
      "blocks": [
        {
          "type": "list",
          "items": [
            {
              "zh-CN": "图标资源必须有 alt text。",
              "en": "Icon assets must have alt text."
            },
            {
              "zh-CN": "主题切换不得让图标不可见或过饱和。",
              "en": "Theme switching must not make icons invisible or oversaturated."
            },
            {
              "zh-CN": "文档图标由 cast-a-doc logo chrome 渲染，不手写 HTML。",
              "en": "Documentation icons are rendered by cast-a-doc logo chrome, not hand-written HTML."
            }
          ]
        }
      ]
    },
    {
      "id": "testing-plan",
      "title": {
        "zh-CN": "测试计划",
        "en": "Testing Plan"
      },
      "blocks": [
        {
          "type": "acceptance-criteria",
          "items": [
            {
              "zh-CN": "light/dark 下检查菜单栏图标可见性。",
              "en": "Check menu-bar icon visibility in light/dark."
            },
            {
              "zh-CN": "docs:check 验证 CAST profile logo。",
              "en": "docs:check validates CAST profile logo."
            }
          ]
        }
      ]
    },
    {
      "id": "open-questions",
      "title": {
        "zh-CN": "开放问题",
        "en": "Open Questions"
      },
      "blocks": [
        {
          "type": "open-questions",
          "questions": [
            {
              "zh-CN": "未明确的行为必须先进入 TODO，而不是在实现里静默猜测。",
              "en": "Unclear behavior must enter TODO first instead of being silently guessed in implementation."
