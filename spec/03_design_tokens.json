  "sections": [
    {
      "id": "overview",
      "title": {
        "zh-CN": "概览",
        "en": "Overview"
      },
      "blocks": [
        {
          "type": "summary",
          "items": [
            {
              "label": {
                "zh-CN": "源",
                "en": "Source"
              },
              "body": {
                "zh-CN": "src/styles/tokens.css 是应用 token 源；CAST 文档只描述契约。",
                "en": "src/styles/tokens.css is the app token source; CAST docs describe the contract."
              }
            },
            {
              "label": {
                "zh-CN": "主题",
                "en": "Theme"
              },
              "body": {
                "zh-CN": "light、dark、system 由前端设置和原生 appearance 同步。",
                "en": "light, dark, and system are synchronized by frontend settings and native appearance."
              }
            },
            {
              "label": {
                "zh-CN": "动效",
                "en": "Motion"
              },
              "body": {
                "zh-CN": "使用 --ease-native；不动画 blur 或导致窗口跳动。",
                "en": "Use --ease-native; do not animate blur or cause window jumps."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "summary",
      "title": {
        "zh-CN": "摘要",
        "en": "Summary"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "zh-CN": "本规格页记录当前实现应遵守的技术契约。若实现发生变化，需要同步更新本页和相关 plan/TODO/CHANGELIST。",
            "en": "This spec records the technical contract the current implementation should follow. If implementation changes, update this page and related plan/TODO/CHANGELIST."
          }
        }
      ]
    },
    {
      "id": "token-domains",
      "title": {
        "zh-CN": "Token Domains",
        "en": "Token Domains"
      },
      "blocks": [
        {
          "type": "table",
          "tableType": "data",
          "headers": [
            {
              "zh-CN": "域",
              "en": "Domain"
            },
            {
              "zh-CN": "用途",
              "en": "Purpose"
            }
          ],
          "rows": [
            [
              {
                "zh-CN": "Color",
                "en": "Color"
              },
              {
                "zh-CN": "primary、valid、warning、danger、surface、text、border。",
                "en": "primary, valid, warning, danger, surface, text, border."
              }
            ],
            [
              {
                "zh-CN": "Type",
                "en": "Type"
              },
              {
                "zh-CN": "编辑器字号可调，chrome 字号紧凑稳定。",
                "en": "Editor font size is adjustable; chrome type is compact and stable."
              }
            ],
            [
              {
                "zh-CN": "Spacing",
                "en": "Spacing"
              },
              {
                "zh-CN": "浮窗和表单使用紧凑节奏，避免卡片套卡片。",
                "en": "Floating window and forms use compact rhythm and avoid nested cards."
              }
            ],
            [
              {
                "zh-CN": "Motion",
                "en": "Motion"
              },
              {
                "zh-CN": "summon/dismiss、tab pill、theme transition 都短时可中断。",
                "en": "summon/dismiss, tab pill, and theme transition are short and interruptible."
              }
            ]
          ]
        }
      ]
    },
    {
      "id": "invariants",
      "title": {
        "zh-CN": "不变量",
        "en": "Invariants"
      },
      "blocks": [
        {
          "type": "list",
          "items": [
            {
              "zh-CN": "不要把设计 demo 的临时颜色带回实现。",
              "en": "Do not bring temporary design-demo colors back into implementation."
            },
            {
              "zh-CN": "dark 次级文本必须保持可读，不靠降低透明度制造氛围。",
              "en": "Dark secondary text must stay readable and not rely on opacity for atmosphere."
            },
            {
              "zh-CN": "CAST HTML 不自定义应用 CSS；它只用 cast-a-doc profile。",
              "en": "CAST HTML does not customize app CSS; it only uses the cast-a-doc profile."
            }
          ]
        }
      ]
    },
    {
      "id": "testing-plan",
      "title": {
        "zh-CN": "测试计划",
        "en": "Testing Plan"
      },
      "blocks": [
        {
          "type": "acceptance-criteria",
          "items": [
            {
              "zh-CN": "视觉变更后检查真实 app 和 spec/01 是否仍一致。",
              "en": "After visual changes, check real app and spec/01 remain aligned."
            },
            {
              "zh-CN": "docs:check 禁止 raw Mermaid/CDN 回归。",
              "en": "docs:check forbids raw Mermaid/CDN regressions."
            }
          ]
        }
      ]
    },
    {
      "id": "open-questions",
      "title": {
        "zh-CN": "开放问题",
        "en": "Open Questions"
      },
      "blocks": [
        {
          "type": "open-questions",
          "questions": [
            {
              "zh-CN": "未明确的行为必须先进入 TODO，而不是在实现里静默猜测。",
              "en": "Unclear behavior must enter TODO first instead of being silently guessed in implementation."
            }
          ]
        }
      ]
    }
  ]
}
