  "sections": [
    {
      "id": "overview",
      "title": {
        "zh-CN": "概览",
        "en": "Overview"
      },
      "blocks": [
        {
          "type": "summary",
          "items": [
            {
              "label": {
                "zh-CN": "形态",
                "en": "Shape"
              },
              "body": {
                "zh-CN": "Tauri 2 Rust 主进程承载窗口、菜单栏、快捷键、存储和 AI 请求；React WebView 承载 UI。",
                "en": "Tauri 2 Rust host owns windowing, menu bar, shortcuts, storage, and AI requests; React WebView owns UI."
              }
            },
            {
              "label": {
                "zh-CN": "边界",
                "en": "Boundary"
              },
              "body": {
                "zh-CN": "JSON engine、storage、AI、window、commands 都在 Rust 边界清晰分层。",
                "en": "JSON engine, storage, AI, window, and commands are separated in Rust."
              }
            },
            {
              "label": {
                "zh-CN": "不变量",
                "en": "Invariant"
              },
              "body": {
                "zh-CN": "用户数据本地保存，错误用 JsonitaError 映射，窗口关闭不退出应用。",
                "en": "User data stays local, errors map through JsonitaError, and closing the window does not quit the app."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "summary",
      "title": {
        "zh-CN": "摘要",
        "en": "Summary"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "zh-CN": "本规格页记录当前实现应遵守的技术契约。若实现发生变化，需要同步更新本页和相关 plan/TODO/CHANGELIST。",
            "en": "This spec records the technical contract the current implementation should follow. If implementation changes, update this page and related plan/TODO/CHANGELIST."
          }
        }
      ]
    },
