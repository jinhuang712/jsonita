    {
      "id": "invariants",
      "title": {
        "zh-CN": "不变量",
        "en": "Invariants"
      },
      "blocks": [
        {
          "type": "list",
          "items": [
            {
              "zh-CN": "WebView 不保存 API key。",
              "en": "WebView does not store API keys."
            },
            {
              "zh-CN": "Rust command 是所有本地文件和网络请求的唯一入口。",
              "en": "Rust commands are the only entrypoint for local files and network requests."
            },
            {
              "zh-CN": "窗口 show/hide 与 app lifetime 分离。",
              "en": "Window show/hide is separated from app lifetime."
            }
          ]
        }
      ]
