  "sections": [
    {
      "id": "overview",
      "title": {
        "zh-CN": "概览",
        "en": "Overview"
      },
      "blocks": [
        {
          "type": "summary",
          "items": [
            {
              "label": {
                "zh-CN": "编辑器",
                "en": "Editor"
              },
              "body": {
                "zh-CN": "CodeMirror view 不能因 parse error 重建。",
                "en": "CodeMirror view must not rebuild because of parse errors."
              }
            },
            {
              "label": {
                "zh-CN": "lint",
                "en": "Lint"
              },
              "body": {
                "zh-CN": "错误标注来自外部 parse 状态，通过 forceLinting 更新。",
                "en": "Error annotations come from external parse state and update through forceLinting."
              }
            },
            {
              "label": {
                "zh-CN": "树",
                "en": "Tree"
              },
              "body": {
                "zh-CN": "Tree 视图按 JSON 类型渲染，支持展开、折叠和复制。",
                "en": "Tree view renders by JSON type and supports expand, collapse, and copy."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "summary",
      "title": {
        "zh-CN": "摘要",
        "en": "Summary"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "zh-CN": "本规格页记录当前实现应遵守的技术契约。若实现发生变化，需要同步更新本页和相关 plan/TODO/CHANGELIST。",
            "en": "This spec records the technical contract the current implementation should follow. If implementation changes, update this page and related plan/TODO/CHANGELIST."
          }
        }
      ]
    },
    {
      "id": "editor-contract",
      "title": {
        "zh-CN": "Editor Contract",
        "en": "Editor Contract"
      },
      "blocks": [
        {
          "type": "table",
          "tableType": "data",
          "headers": [
            {
              "zh-CN": "主题",
              "en": "Topic"
            },
            {
              "zh-CN": "约定",
              "en": "Contract"
            }
          ],
          "rows": [
            [
              {
                "zh-CN": "Lifecycle",
                "en": "Lifecycle"
              },
              {
                "zh-CN": "初始化 effect 不依赖 cfg.error。",
                "en": "Initialization effect does not depend on cfg.error."
              }
            ],
            [
              {
                "zh-CN": "Lint",
                "en": "Lint"
              },
              {
                "zh-CN": "errorRef 保存最新错误；合法后清 diagnostics。",
                "en": "errorRef stores latest error; valid state clears diagnostics."
              }
            ],
            [
              {
                "zh-CN": "Output",
                "en": "Output"
              },
              {
                "zh-CN": "转换结果以 request sequence 防旧结果覆盖新输入。",
                "en": "Transform results use request sequence to prevent stale results overriding new input."
              }
            ],
            [
              {
                "zh-CN": "Tree",
                "en": "Tree"
              },
              {
                "zh-CN": "大结构要保持可滚动和可扫描。",
                "en": "Large structures must remain scrollable and scannable."
              }
            ]
          ]
        }
      ]
    },
    {
      "id": "invariants",
      "title": {
        "zh-CN": "不变量",
        "en": "Invariants"
      },
      "blocks": [
        {
          "type": "list",
          "items": [
            {
              "zh-CN": "半截 JSON 仍可继续输入。",
              "en": "Half-written JSON remains editable."
            },
            {
              "zh-CN": "合法后 gutter 不残留旧错误。",
              "en": "Gutter does not retain old errors after valid input."
            },
            {
              "zh-CN": "tree copy 不写入日志正文。",
              "en": "Tree copy does not write body content to logs."
            }
          ]
        }
      ]
    },
    {
      "id": "testing-plan",
      "title": {
        "zh-CN": "测试计划",
        "en": "Testing Plan"
      },
      "blocks": [
        {
          "type": "acceptance-criteria",
          "items": [
            {
              "zh-CN": "输入 invalid -> valid 的 lint 清理回归。",
              "en": "Regression for invalid-to-valid lint cleanup."
            },
            {
              "zh-CN": "大 JSON tree 展开/复制 smoke。",
              "en": "Large JSON tree expand/copy smoke."
            }
          ]
        }
      ]
    },
    {
      "id": "open-questions",
      "title": {
        "zh-CN": "开放问题",
        "en": "Open Questions"
      },
      "blocks": [
        {
          "type": "open-questions",
          "questions": [
            {
              "zh-CN": "未明确的行为必须先进入 TODO，而不是在实现里静默猜测。",
              "en": "Unclear behavior must enter TODO first instead of being silently guessed in implementation."
            }
          ]
        }
      ]
    }
  ]
}
