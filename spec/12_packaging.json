    {
      "id": "invariants",
      "title": {
        "zh-CN": "不变量",
        "en": "Invariants"
      },
      "blocks": [
        {
          "type": "list",
          "items": [
            {
              "zh-CN": "Windows 对外发送 NSIS installer，不发送裸 exe。",
              "en": "Windows distribution sends the NSIS installer, not the bare exe."
            },
            {
              "zh-CN": "Homebrew 是 Cask，不是 formula。",
              "en": "Homebrew distribution is a Cask, not a formula."
            },
            {
              "zh-CN": "发布脚本保持分目标入口，不合成单个难读脚本。",
              "en": "Release scripts remain separate target entrypoints, not one hard-to-read monolith."
            }
          ]
        }
      ]
