  "sections": [
    {
      "id": "overview",
      "title": {
        "zh-CN": "概览",
        "en": "Overview"
      },
      "blocks": [
        {
          "type": "summary",
          "items": [
            {
              "label": {
                "zh-CN": "原则",
                "en": "Principle"
              },
              "body": {
                "zh-CN": "前端只通过 typed IPC 调 Rust；Rust 返回可序列化 payload。",
                "en": "Frontend calls Rust only through typed IPC; Rust returns serializable payloads."
              }
            },
            {
              "label": {
                "zh-CN": "错误",
                "en": "Errors"
              },
              "body": {
                "zh-CN": "所有业务错误统一映射到 JsonitaError / TS discriminated union。",
                "en": "All business errors map into JsonitaError and a TypeScript discriminated union."
              }
            },
            {
              "label": {
                "zh-CN": "事件",
                "en": "Events"
              },
              "body": {
                "zh-CN": "窗口、主题、历史和设置变化可通过事件通知，但不得携带敏感正文。",
                "en": "Window, theme, history, and settings changes may emit events but must not carry sensitive body content."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "summary",
      "title": {
        "zh-CN": "摘要",
        "en": "Summary"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "zh-CN": "本规格页记录当前实现应遵守的技术契约。若实现发生变化，需要同步更新本页和相关 plan/TODO/CHANGELIST。",
            "en": "This spec records the technical contract the current implementation should follow. If implementation changes, update this page and related plan/TODO/CHANGELIST."
          }
        }
      ]
    },
