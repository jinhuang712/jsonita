    {
      "id": "invariants",
      "title": {
        "zh-CN": "不变量",
        "en": "Invariants"
      },
      "blocks": [
        {
          "type": "list",
          "items": [
            {
              "zh-CN": "IPC payload 不包含 API key。",
              "en": "IPC payloads do not include API keys."
            },
            {
              "zh-CN": "错误文本可以给用户看，但日志记录要脱敏。",
              "en": "Error text may be shown to users, but logs must redact sensitive data."
            },
            {
              "zh-CN": "前端 fallback 只能用于 dev/non-Tauri 环境。",
              "en": "Frontend fallback is only for dev/non-Tauri environments."
            }
          ]
        }
      ]
    },
    {
      "id": "testing-plan",
      "title": {
        "zh-CN": "测试计划",
        "en": "Testing Plan"
      },
      "blocks": [
        {
          "type": "acceptance-criteria",
          "items": [
            {
              "zh-CN": "TS command wrappers 使用 discriminated union。",
              "en": "TS command wrappers use discriminated unions."
            },
            {
              "zh-CN": "Rust command 返回 serde 可序列化结构。",
              "en": "Rust commands return serde-serializable structures."
            }
          ]
        }
      ]
    },
