    {
      "id": "commands",
      "title": {
        "zh-CN": "Commands",
        "en": "Commands"
      },
      "blocks": [
        {
          "type": "code",
          "language": "bash",
          "code": "pnpm docs:render\npnpm docs:check\npnpm exec node scripts/verify_doc_links.mjs\npnpm tsc --noEmit"
        },
        {
          "type": "paragraph",
          "text": {
            "zh-CN": "docs:render 会遍历 site、plan、spec 的 CAST JSON 源，并逐页调用 cast-a-doc 的 render_html.py。docs:check 会验证 profile、freshness、双语结构和发布面。",
            "en": "docs:render traverses CAST JSON sources under site, plan, and spec, and calls cast-a-doc render_html.py page by page. docs:check validates profile, freshness, bilingual structure, and published surface."
          }
        }
      ]
    },
    {
      "id": "change-protocol",
      "title": {
        "zh-CN": "Change Protocol",
        "en": "Change Protocol"
      },
      "blocks": [
        {
          "type": "list",
          "items": [
            {
              "zh-CN": "产品范围变化：更新 plan、相关 spec、TODO/CHANGELIST，并重新渲染。",
              "en": "Product scope change: update plan, related spec, TODO/CHANGELIST, and rerender."
            },
            {
              "zh-CN": "实现行为变化：同步检查 spec/ 与 plan/ 对应章节。",
              "en": "Implementation behavior change: check corresponding spec/ and plan/ sections."
            },
            {
              "zh-CN": "发布或 workflow 变化：更新 README、首页、workflow、TODO/CHANGELIST。",
              "en": "Release or workflow change: update README, homepage, workflow, TODO/CHANGELIST."
            },
            {
              "zh-CN": "不确定时给选项并询问；不要猜测会影响范围或技术方向的决定。",
              "en": "When uncertain, offer options and ask; do not guess decisions that affect scope or technical direction."
            }
          ]
        }
      ]
    },
