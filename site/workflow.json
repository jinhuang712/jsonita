      "blocks": [
        {
          "type": "summary",
          "items": [
            {
              "label": {
                "zh-CN": "源",
                "en": "Source"
              },
              "body": {
                "zh-CN": "每个公开 CAST 页面以 JSON 为源，HTML 为生成物。",
                "en": "Every published CAST page uses JSON as source and HTML as generated output."
              }
            },
            {
              "label": {
                "zh-CN": "渲染",
                "en": "Rendering"
              },
              "body": {
                "zh-CN": "渲染只走 cast-a-doc/scripts/render_html.py --validate。",
                "en": "Rendering only uses cast-a-doc/scripts/render_html.py --validate."
              }
            },
            {
              "label": {
                "zh-CN": "计划",
                "en": "Planning"
              },
              "body": {
                "zh-CN": "cast-a-start 负责文档集结构、首页、TODO、CHANGELIST 和 gate。",
                "en": "cast-a-start owns document-set structure, homepage, TODO, CHANGELIST, and gates."
              }
            }
          ]
        }
      ]
    },
