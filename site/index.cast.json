      "id": "overview",
      "title": {
        "zh-CN": "入口说明",
        "en": "Entrypoint"
      },
      "blocks": [
        {
          "type": "summary",
          "items": [
            {
              "label": {
                "zh-CN": "产品",
                "en": "Product"
              },
              "body": {
                "zh-CN": "Jsonita 是一款常驻 macOS 菜单栏、按全局快捷键瞬时呼出的极轻量 JSON 工具集。",
                "en": "Jsonita is a tiny macOS menu-bar JSON toolkit that appears instantly from a global shortcut."
              }
            },
            {
              "label": {
                "zh-CN": "文档约定",
                "en": "Documentation Contract"
              },
              "body": {
                "zh-CN": "本项目文档严格依赖 CAST：产品范围、实现计划、技术规格、TODO、Changelist 与文档入口必须同步维护。",
                "en": "This project strictly relies on CAST: product scope, implementation plans, technical specs, TODOs, changelists, and documentation entrypoints must stay synchronized."
              }
            }
          ]
        },
        {
          "type": "callout",
          "variant": "info",
          "title": {
            "zh-CN": "双语规则",
            "en": "Bilingual Rule"
          },
          "body": {
            "zh-CN": "这个首页由 site/index.cast.json 渲染而来，同一个 HTML 同时包含中文和英文内容，并在右上角提供语言切换。",
            "en": "This homepage is rendered from site/index.cast.json. The same HTML file contains both Simplified Chinese and English content, with a language switcher in the top-right corner."
          }
        }
      ]
    },
