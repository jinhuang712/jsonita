{
  "name": "jsonita",
  "version": "1.0.0-beta.3",
  "description": "Tiny menu-bar JSON toolkit",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "release:macos:dmg": "bash scripts/release-macos-dmg.sh",
    "release:macos:app": "bash scripts/release-macos-app.sh",
    "deploy:local:macos": "bash scripts/deploy-local-macos-app.sh",
    "release:windows:exe": "bash scripts/release-windows-exe.sh",
    "release:all": "bash scripts/release-all.sh",
    "tauri": "tauri",
    "tsc": "tsc --noEmit",
    "test:node": "find tests -name '*.test.mjs' -print0 | xargs -0 node --test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/language": "^6.10.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.34.0",
    "@lezer/highlight": "^1.2.1",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@tauri-apps/api": "^2.1.1",
    "diff": "^7.0.0",
    "i18next": "^23.16.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/diff": "^7.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0"
}
