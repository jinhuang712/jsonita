  "sections": [
    {
      "id": "overview",
      "title": {
        "zh-CN": "概览",
        "en": "Overview"
      },
      "blocks": [
        {
          "type": "summary",
          "items": [
            {
              "label": {
                "zh-CN": "核心范围",
                "en": "Core Scope"
              },
              "body": {
                "zh-CN": "Format、Minify、Tree、string 转换、unwrap、AI Fix、history、session、settings、smart width。",
                "en": "Format, Minify, Tree, string conversion, unwrap, AI Fix, history, session, settings, and smart width."
              }
            },
            {
              "label": {
                "zh-CN": "工作流",
                "en": "Workflow"
              },
              "body": {
                "zh-CN": "粘贴即预览，合法 JSON 直接出结果，非法 JSON 进入 AI 修复路径。",
                "en": "Paste to preview; valid JSON produces output directly and invalid JSON enters AI repair."
              }
            },
            {
              "label": {
                "zh-CN": "后置",
                "en": "Deferred"
              },
              "body": {
                "zh-CN": "云同步、Homebrew、updater、npm wrapper、Windows 正式分发放到 v1.1+。",
                "en": "Cloud sync, Homebrew, updater, npm wrapper, and formal Windows distribution stay v1.1+."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "summary",
      "title": {
        "zh-CN": "摘要",
        "en": "Summary"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "zh-CN": "本页把 v1.0 可见功能压成可验收清单。技术实现细节分别落在 spec/08、spec/09、spec/10、spec/11。",
            "en": "This page turns v1.0 visible behavior into an acceptance-ready list. Implementation details live in spec/08, spec/09, spec/10, and spec/11."
          }
        }
      ]
    },
    {
      "id": "requirements",
      "title": {
        "zh-CN": "Requirements",
        "en": "Requirements"
      },
      "blocks": [
        {
          "type": "table",
          "tableType": "data",
          "headers": [
            {
              "zh-CN": "编号",
              "en": "ID"
            },
            {
              "zh-CN": "功能",
              "en": "Feature"
            },
            {
              "zh-CN": "用户价值",
              "en": "User Value"
            },
            {
              "zh-CN": "验收",
              "en": "Acceptance"
            }
          ],
          "rows": [
            [
              {
                "zh-CN": "F1",
                "en": "F1"
              },
              {
                "zh-CN": "JSON 格式化",
                "en": "JSON Format"
              },
              {
                "zh-CN": "把压缩或混乱 JSON 变成可读结构。",
                "en": "Turn compact or messy JSON into readable structure."
              },
              {
                "zh-CN": "2 / 4 / Tab 缩进、sort keys、trailing newline 可配置。",
                "en": "2 / 4 / Tab indent, sort keys, and trailing newline are configurable."
              }
            ],
            [
              {
                "zh-CN": "F2",
                "en": "F2"
              },
              {
                "zh-CN": "Minify",
                "en": "Minify"
              },
              {
                "zh-CN": "把结构化 JSON 压成单行。",
                "en": "Compress structured JSON into one line."
              },
              {
                "zh-CN": "合法 JSON 输出无多余空白，错误不覆盖输入。",
                "en": "Valid JSON outputs without extra whitespace; errors do not overwrite input."
              }
            ],
            [
              {
                "zh-CN": "F3",
                "en": "F3"
              },
              {
                "zh-CN": "Tree 视图",
                "en": "Tree View"
              },
              {
                "zh-CN": "快速浏览嵌套结构和类型。",
                "en": "Browse nested structure and types quickly."
              },
              {
                "zh-CN": "节点可展开折叠，类型染色，叶子可复制。",
                "en": "Nodes expand/collapse, types are colored, and leaf values can be copied."
              }
            ],
            [
              {
                "zh-CN": "F4",
                "en": "F4"
              },
              {
                "zh-CN": "String ↔ JSON",
                "en": "String to/from JSON"
              },
              {
                "zh-CN": "处理日志中的转义 JSON。",
                "en": "Handle escaped JSON inside logs."
              },
              {
                "zh-CN": "4 层嵌套往返一致。",
                "en": "Round-trip is consistent across four nested levels."
              }
            ],
            [
              {
                "zh-CN": "F5",
                "en": "F5"
              },
              {
                "zh-CN": "嵌套 stringified 解开",
                "en": "Nested stringified unwrap"
              },
              {
                "zh-CN": "展开 Go/proto 风格多层 wrap。",
                "en": "Unwrap Go/proto-style multi-layer strings."
              },
              {
                "zh-CN": "全局 200 ms 超时兜底。",
                "en": "Global 200 ms timeout guard."
              }
            ],
            [
              {
                "zh-CN": "F6",
                "en": "F6"
              },
              {
                "zh-CN": "AI Auto-Fix",
                "en": "AI Auto-Fix"
              },
              {
                "zh-CN": "修复缺逗号、单引号、注释等常见非法 JSON。",
                "en": "Fix common invalid JSON issues such as missing commas, single quotes, and comments."
              },
              {
                "zh-CN": "DeepSeek key 缺失时禁用；修复结果必须先展示 diff。",
                "en": "Disabled without a DeepSeek key; repaired result must show a diff first."
              }
            ],
            [
              {
                "zh-CN": "F7",
                "en": "F7"
              },
              {
                "zh-CN": "History",
                "en": "History"
              },
              {
                "zh-CN": "找回近期片段和结果。",
                "en": "Recover recent snippets and outputs."
              },
              {
                "zh-CN": "SQLite FTS5、去重、pin/star、100 条上限。",
                "en": "SQLite FTS5, dedupe, pin/star, and a 100-item cap."
              }
            ],
            [
              {
                "zh-CN": "F8",
                "en": "F8"
              },
              {
                "zh-CN": "Session Restore",
                "en": "Session Restore"
              },
              {
                "zh-CN": "重新呼出时恢复最近合法工作状态。",
                "en": "Restore recent valid working state when summoned again."
              },
              {
                "zh-CN": "合法 transform 后保存；Cmd+Shift+L 手动恢复。",
                "en": "Save after valid transform; Cmd+Shift+L restores manually."
              }
            ],
            [
              {
                "zh-CN": "F9",
                "en": "F9"
              },
              {
                "zh-CN": "单窗 / 双栏",
                "en": "Single / Split Pane"
              },
              {
                "zh-CN": "在窄屏或快速查看时减少视觉负担。",
                "en": "Reduce visual load on narrow screens or quick inspection."
              },
              {
                "zh-CN": "切换不 remount CodeMirror，不丢光标。",
                "en": "Switching does not remount CodeMirror or lose cursor state."
              }
            ],
            [
              {
                "zh-CN": "F10",
                "en": "F10"
              },
              {
                "zh-CN": "Smart Width",
                "en": "Smart Width"
              },
              {
                "zh-CN": "长行自动扩宽，短内容保持轻量。",
                "en": "Auto-expand for long lines while keeping short content light."
              },
              {
                "zh-CN": "手动拖拽锁定、soft-wrap 跳过、阈值和最大宽度受设置控制。",
                "en": "Manual drag lock, soft-wrap skip, threshold, and max width are settings-driven."
              }
            ]
          ]
        }
      ]
    },
    {
      "id": "user-flows",
      "title": {
        "zh-CN": "User Flows",
        "en": "User Flows"
      },
      "blocks": [
        {
          "type": "list",
          "items": [
            {
              "zh-CN": "合法 JSON：Cmd+Shift+J → 粘贴 → 右侧 300 ms 内预览 → 选择 tab → 复制。",
              "en": "Valid JSON: Cmd+Shift+J -> paste -> preview within 300 ms -> choose tab -> copy."
            },
            {
              "zh-CN": "非法 JSON：粘贴 → 状态栏显示错误 → AI Fix tab 可用 → 修复 → DiffView → Accept。",
              "en": "Invalid JSON: paste -> status bar shows error -> AI Fix tab is available -> repair -> DiffView -> Accept."
            },
            {
              "zh-CN": "找回：Cmd+Shift+L 恢复最近会话，或从 History 搜索/pin/star 条目。",
              "en": "Recovery: Cmd+Shift+L restores the recent session, or use History search/pin/star entries."
            }
          ]
        }
      ]
    },
