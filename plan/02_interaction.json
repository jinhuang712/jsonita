  "sections": [
    {
      "id": "overview",
      "title": {
        "zh-CN": "概览",
        "en": "Overview"
      },
      "blocks": [
        {
          "type": "summary",
          "items": [
            {
              "label": {
                "zh-CN": "入口",
                "en": "Entry"
              },
              "body": {
                "zh-CN": "菜单栏图标和 Cmd+Shift+J 是主入口。",
                "en": "Menu-bar icon and Cmd+Shift+J are the primary entrypoints."
              }
            },
            {
              "label": {
                "zh-CN": "主界面",
                "en": "Main UI"
              },
              "body": {
                "zh-CN": "左输入、右输出或单窗；状态栏承载 validity、history、单窗切换。",
                "en": "Left input plus right output or single pane; status bar carries validity, history, and pane switch."
              }
            },
            {
              "label": {
                "zh-CN": "退出",
                "en": "Dismiss"
              },
              "body": {
                "zh-CN": "Esc、Cmd+W 或 blur hide 关闭浮窗，不退出应用。",
                "en": "Esc, Cmd+W, or blur hide closes the floating window, not the app."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "summary",
      "title": {
        "zh-CN": "摘要",
        "en": "Summary"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "zh-CN": "交互设计目标是减少“打开应用”的存在感，让 Jsonita 像剪贴板旁边的临时工具。",
            "en": "The interaction goal is to reduce the feeling of opening an app and make Jsonita feel like a temporary tool beside the clipboard."
          }
        }
      ]
    },
    {
      "id": "requirements",
      "title": {
        "zh-CN": "Requirements",
        "en": "Requirements"
      },
      "blocks": [
        {
          "type": "table",
          "tableType": "data",
          "headers": [
            {
              "zh-CN": "区域",
              "en": "Area"
            },
            {
              "zh-CN": "行为",
              "en": "Behavior"
            }
          ],
          "rows": [
            [
              {
                "zh-CN": "主浮窗",
                "en": "Main floating window"
              },
              {
                "zh-CN": "默认居中，玻璃材质，双栏布局；可切单窗。",
                "en": "Centered by default, glass material, split-pane layout, switchable to single pane."
              }
            ],
            [
              {
                "zh-CN": "Tab",
                "en": "Tabs"
              },
              {
                "zh-CN": "Format / Minify / Tree / to String / to JSON / AI Fix；AI Fix 仅在有修复条件时可用。",
                "en": "Format / Minify / Tree / to String / to JSON / AI Fix; AI Fix is enabled only when repair conditions exist."
              }
            ],
            [
              {
                "zh-CN": "状态栏",
                "en": "Status bar"
              },
              {
                "zh-CN": "显示 Valid / Invalid、行列、History、单窗切换和 Run hint。",
                "en": "Shows Valid / Invalid, line/column, History, single-pane switch, and Run hint."
              }
            ],
            [
              {
                "zh-CN": "Settings",
                "en": "Settings"
              },
              {
                "zh-CN": "语言、主题、快捷键、格式、AI key、About 分组。",
                "en": "Language, theme, shortcuts, formatting, AI key, and About groups."
              }
            ],
            [
              {
                "zh-CN": "History",
                "en": "History"
              },
              {
                "zh-CN": "搜索、pin、star、恢复；不会自动上传。",
                "en": "Search, pin, star, and restore; never auto-uploads."
              }
            ]
          ]
        }
      ]
    },
    {
      "id": "user-flows",
      "title": {
        "zh-CN": "User Flows",
        "en": "User Flows"
      },
      "blocks": [
        {
          "type": "table",
          "tableType": "data",
          "headers": [
            {
              "zh-CN": "流程",
              "en": "Flow"
            },
            {
              "zh-CN": "步骤",
              "en": "Steps"
            }
          ],
          "rows": [
            [
              {
                "zh-CN": "呼出",
                "en": "Summon"
              },
              {
                "zh-CN": "Cmd+Shift+J → app 激活浮窗 → 不显示 Dock 图标。",
                "en": "Cmd+Shift+J -> app activates floating window -> no Dock icon."
              }
            ],
            [
              {
                "zh-CN": "转换",
                "en": "Transform"
              },
              {
                "zh-CN": "输入变化 debounce → Rust JSON engine → 输出 tab 更新。",
                "en": "Input changes debounce -> Rust JSON engine -> output tab updates."
              }
            ],
            [
              {
                "zh-CN": "AI 修复",
                "en": "AI repair"
              },
              {
                "zh-CN": "非法 JSON + API key → DeepSeek 请求 → extract_json → diff → Accept。",
                "en": "Invalid JSON plus API key -> DeepSeek request -> extract_json -> diff -> Accept."
              }
            ],
            [
              {
                "zh-CN": "关闭",
                "en": "Close"
              },
              {
                "zh-CN": "Esc / Cmd+W / blur hide → 保存合法会话 → 隐藏窗口。",
                "en": "Esc / Cmd+W / blur hide -> save valid session -> hide window."
              }
            ]
          ]
        }
      ]
    },
    {
      "id": "shortcuts",
      "title": {
        "zh-CN": "Shortcut Contract",
        "en": "Shortcut Contract"
      },
      "blocks": [
        {
          "type": "table",
          "tableType": "data",
          "headers": [
            {
              "zh-CN": "快捷键",
              "en": "Shortcut"
            },
            {
              "zh-CN": "默认",
              "en": "Default"
            },
            {
              "zh-CN": "作用",
              "en": "Purpose"
            }
          ],
          "rows": [
            [
              {
                "zh-CN": "召回窗口",
                "en": "Summon window"
              },
              {
                "zh-CN": "Cmd+Shift+J",
                "en": "Cmd+Shift+J"
              },
              {
                "zh-CN": "全局显示/聚焦 Jsonita。",
                "en": "Globally show/focus Jsonita."
              }
            ],
            [
              {
                "zh-CN": "恢复会话",
                "en": "Restore session"
              },
              {
                "zh-CN": "Cmd+Shift+L",
                "en": "Cmd+Shift+L"
              },
              {
                "zh-CN": "恢复最近合法会话。",
                "en": "Restore latest valid session."
              }
            ],
            [
              {
                "zh-CN": "清空",
                "en": "Clear"
              },
              {
                "zh-CN": "Cmd+K",
                "en": "Cmd+K"
              },
              {
                "zh-CN": "清空当前输入输出。",
                "en": "Clear current input and output."
              }
            ],
            [
              {
                "zh-CN": "关闭",
                "en": "Dismiss"
              },
              {
                "zh-CN": "Esc / Cmd+W",
                "en": "Esc / Cmd+W"
              },
              {
                "zh-CN": "隐藏浮窗。",
                "en": "Hide the floating window."
              }
            ],
            [
              {
                "zh-CN": "单窗切换",
                "en": "Pane toggle"
              },
              {
                "zh-CN": "Cmd+\\",
                "en": "Cmd+\\"
              },
              {
                "zh-CN": "窗口内切换 single/split pane。",
                "en": "Toggle single/split pane inside the window."
              }
            ]
          ]
        }
      ]
    },
    {
      "id": "edge-cases",
      "title": {
        "zh-CN": "Edge Cases",
        "en": "Edge Cases"
      },
      "blocks": [
        {
          "type": "list",
          "items": [
            {
              "zh-CN": "快捷键冲突时提示并允许 override 二次确认。",
              "en": "Shortcut conflicts prompt and require override confirmation."
            },
            {
              "zh-CN": "AI key 缺失时 AI Fix tab 展示 disabled prompt，不发请求。",
              "en": "When the AI key is missing, the AI Fix tab shows a disabled prompt and sends no request."
            },
            {
              "zh-CN": "切换 single/split 不重建 CodeMirror，也不触发额外 smart width 跳窗。",
              "en": "Switching single/split does not rebuild CodeMirror or trigger extra smart-width jumps."
            }
          ]
        }
      ]
    },
    {
      "id": "acceptance-criteria",
      "title": {
        "zh-CN": "验收标准",
        "en": "Acceptance Criteria"
      },
      "blocks": [
        {
          "type": "acceptance-criteria",
          "items": [
            {
              "zh-CN": "用户能从键盘完成呼出、粘贴、转换、复制、关闭。",
              "en": "Users can summon, paste, transform, copy, and dismiss from the keyboard."
            },
            {
              "zh-CN": "错误状态不会阻止继续输入。",
              "en": "Error state does not block continued input."
            }
          ]
        }
      ]
    },
    {
      "id": "open-questions",
      "title": {
        "zh-CN": "开放问题",
        "en": "Open Questions"
      },
      "blocks": [
        {
          "type": "open-questions",
          "questions": [
            {
              "zh-CN": "真实 macOS 环境还需要复核 vibrancy 与 system theme 跟随。",
              "en": "Real macOS verification is still needed for vibrancy and system-theme following."
            }
          ]
        }
      ]
    }
  ]
}
