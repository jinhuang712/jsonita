  "sections": [
    {
      "id": "overview",
      "title": {
        "zh-CN": "概览",
        "en": "Overview"
      },
      "blocks": [
        {
          "type": "summary",
          "items": [
            {
              "label": {
                "zh-CN": "壳层",
                "en": "Shell"
              },
              "body": {
                "zh-CN": "Tauri 2 + Rust 主进程 + React WebView。",
                "en": "Tauri 2 plus Rust host plus React WebView."
              }
            },
            {
              "label": {
                "zh-CN": "编辑器",
                "en": "Editor"
              },
              "body": {
                "zh-CN": "CodeMirror 处理 JSON 编辑、lint 和视图状态。",
                "en": "CodeMirror handles JSON editing, lint, and view state."
              }
            },
            {
              "label": {
                "zh-CN": "数据",
                "en": "Data"
              },
              "body": {
                "zh-CN": "SQLite FTS5 + settings.json + window.json + secrets.json。",
                "en": "SQLite FTS5 plus settings.json, window.json, and secrets.json."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "summary",
      "title": {
        "zh-CN": "摘要",
        "en": "Summary"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "zh-CN": "选型原则是小、快、本地可控。任何引入云端、重运行时或复杂安装链的方案都必须证明能明显改善 v1 核心工作流。",
            "en": "The selection principle is small, fast, and locally controllable. Any cloud, heavy runtime, or complex installation chain must prove a clear improvement to the v1 core workflow."
          }
        }
      ]
    },
    {
      "id": "options-considered",
      "title": {
        "zh-CN": "Options Considered",
        "en": "Options Considered"
      },
      "blocks": [
        {
          "type": "table",
          "tableType": "data",
          "headers": [
            {
              "zh-CN": "层",
              "en": "Layer"
            },
            {
              "zh-CN": "选择",
              "en": "Choice"
