    {
      "id": "acceptance-criteria",
      "title": {
        "zh-CN": "验收标准",
        "en": "Acceptance Criteria"
      },
      "blocks": [
        {
          "type": "acceptance-criteria",
          "items": [
            {
              "zh-CN": "新技术选择必须在 spec 中声明接口、失败模式和验证方式。",
              "en": "New technology choices must declare interfaces, failure modes, and validation in spec."
            },
            {
              "zh-CN": "凭据相关改动不得重新引入 Keychain。",
              "en": "Secret-related changes must not reintroduce Keychain."
            }
          ]
        }
      ]
    },
