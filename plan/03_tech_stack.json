          "rows": [
            [
              {
                "zh-CN": "Homebrew 被误认为当前已就绪。",
                "en": "Homebrew could be mistaken as already ready."
              },
              {
                "zh-CN": "可能影响交付或用户信任。",
                "en": "May affect delivery or user trust."
              },
              {
                "zh-CN": "文档明确拆分：本地打包脚本已存在，Release workflow/tagged asset/sha256 仍未完成。",
                "en": "Docs explicitly split this: local packaging scripts exist, while release workflow/tagged asset/sha256 remain unfinished."
              }
            ]
          ]
